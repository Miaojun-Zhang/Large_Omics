sample_names = ["TLE66_N", "TLE66_T"]
DB= "/staging/leuven/stg_00079/teaching/hg38_9/chr9.fa"

rule all:
    input: 
           "100.final/snps.annotated.tsv",
           "160.figures/fig1_impact_severity.svg",
           "160.figures/fig2_top_affected_genes.svg",
           "160.figures/fig3_qual_density.svg",
           "upload_done.flag"

rule download_fastq:
    output:
           "{sample}.fastq"
    shell:
           """
           iron get \
           /gbiomed/home/large_omics_course/fastq/{wildcards.sample}.fastq \
           {output}
           """
      

    
rule fast_qc:
    input:
           "{sample}.fastq"
    output:
           html = "010_fastqc_output/{sample}_fastqc.html",
           zip = "010_fastqc_output/{sample}_fastqc.zip"
    shell:
           """
           set -euo pipefail
           mkdir -p 010_fastqc_output
           fastqc {input} --outdir 010_fastqc_output
           test -s {output.html}
           test -s {output.zip}
           """

rule bwa_align:
     input:
          fastq= "{sample}.fastq",
          qc="010_fastqc_output/{sample}_fastqc.html"
     output:
           bam = "020_bam/{sample}.bam",
           bai = "020_bam/{sample}.bam.bai"  
     shell:
           """
           set -euo pipefail
           mkdir -p 020_bam
           bwa mem {DB} {input.fastq} | samtools sort -o {output.bam} -
           samtools index {output.bam} 
           test -s {output.bam}
           test -s {output.bai}
           """

rule bcftools_calling:
     input:
           bam = expand("020_bam/{sample}.bam", sample=sample_names),
           bai = expand("020_bam/{sample}.bam.bai", sample=sample_names)
     output:
           raw_vcf = "030_bcftools/raw_snps.vcf",
           stats="030_bcftools/stats.txt"
     shell:
           """
           set -euo pipefail
           mkdir -p 030_bcftools
           bcftools mpileup -Ou -f {DB} {input.bam} \
           | bcftools call -mv -Ov -o {output.raw_vcf}
           test -s {output.raw_vcf}
           grep -q "^#CHROM" {output.raw_vcf}
           bcftools stats {output.raw_vcf} > {output.stats}
           """

rule snp_filtering:
     input:
           raw_vcf = "030_bcftools/raw_snps.vcf"
     output:
           cleaned_vcf = "040_clean_vcf/clean_snps.vcf"
     shell:
           """
           set -euo pipefail
           mkdir -p 040_clean_vcf
           cat {input.raw_vcf} \
           | vt decompose - \
           | vt normalize -n -r {DB} - \
           | vt uniq - \
           | vt view -f "QUAL>20" -h - \
           > {output.cleaned_vcf}
           test -s {output.cleaned_vcf}
           grep -q "^#CHROM" {output.cleaned_vcf}
           """

rule snp_annotation:
     input:
           cleaned_vcf = "040_clean_vcf/clean_snps.vcf"
     output:
           annotated_vcf = "050_snp_annotation/annotated_snps.vcf"
     shell:
           """
           set -euo pipefail
           mkdir -p 050_snp_annotation
           java -Xmx3400m -jar /lustre1/project/stg_00079/teaching/I0U19a_conda_2026/share/snpeff-5.4.0a-0/snpEff.jar eff hg38 -dataDir /staging/leuven/stg_00079/teaching/snpeff_db {input.cleaned_vcf} > {output.annotated_vcf}
           test -s {output.annotated_vcf}
           grep -q "ANN=" {output.annotated_vcf}
           """

rule load_database:
      input:
          "050_snp_annotation/annotated_snps.vcf"
      output:
          "150.db/snps.sqlite"
      script:
          "snp_database.py"

rule plot_figures:
      input:
          "150.db/snps.sqlite"
      output:
          fig1 = "160.figures/fig1_impact_severity.svg",
          fig2 = "160.figures/fig2_top_affected_genes.svg",
          fig3 = "160.figures/fig3_qual_density.svg"
      script:
          "visualization.py"

rule create_tsv:
     input:
           annotated_vcf = "050_snp_annotation/annotated_snps.vcf"
     output:
           "100.final/snps.annotated.tsv"
     shell:
           """
           set -euo pipefail
           mkdir -p 100.final
           printf "CHROM\tPOS\tREF\tALT\tQUAL\tFILTER\tANN\n" > {output}
           bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%QUAL\t%FILTER\t%INFO/ANN\n' {input.annotated_vcf} >> {output}
           test -s {output}
           head -n 1 {output} | grep -q "CHROM"
           """

rule upload_to_Mango:
      input:
           annotated_vcf = "050_snp_annotation/annotated_snps.vcf"
      
      output:
           touch("upload_done.flag")
      shell:
           """
           set -euo pipefail

           iron mkdir -p /gbiomed/home/large_omics_course/output/r1079125/

           iron put \
           {input.annotated_vcf} \
           /gbiomed/home/large_omics_course/output/r1079125/
           """
           
      

           
          
